# Editor settings, so a contributor on another editor does not reformat a file
# they only meant to read.
#
# Every value here was measured against what the repository already contains,
# not taken from a template. A file that disagreed with its own sources would
# be worse than none: it would quietly rewrite them on the next save, and that
# diff lands on lines nobody touched.
#
# The CI side of the same concern lives elsewhere: `cargo fmt --all --check`
# owns Rust formatting, and nothing here can override rustfmt. This file covers
# the file types no formatter in this repository claims.

root = true

[*]
charset = utf-8
# LF, matching .gitattributes, which normalises what is stored and pins `*.rs`
# to LF in the working tree as well. An editor writing CRLF would undo that for
# every file it saves.
end_of_line = lf
insert_final_newline = true
# No tab appears in any tracked source file today, measured across .rs, .toml,
# .yml, .md, .sh and .py.
indent_style = space
# Safe to trim: no tracked Markdown uses two trailing spaces as a hard line
# break, so there is nothing significant to protect, and trailing whitespace
# that accumulates invisibly is the thing worth preventing.
trim_trailing_whitespace = true

[*.rs]
# rustfmt's default and what it enforces in CI. Stated so an editor agrees with
# it while typing, rather than only after `cargo fmt`.
indent_size = 4

[*.toml]
# 4, which is what Cargo.toml and deny.toml already use. Note this differs from
# taplo's default of 2: the repository wins.
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
# 2, which is what `serde_json::to_string_pretty` emits. The files in schemas/
# are generated by `rbx-schema` and checked in CI, so an editor reformatting
# one would read as drift from the config models it was derived from.
indent_size = 2

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# No indent_size: list nesting in Markdown is content, and an editor
# normalising it changes how a page renders.
indent_size = unset
