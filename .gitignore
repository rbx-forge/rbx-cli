/target

# `mkdocs build` output. The site is built by CI from docs/ on every push to
# main and served from GitHub Pages; nothing rendered is ever committed.
/site

# Editor/tool configs
.idea/
.vscode/
.zed/
.claude/

# Python bytecode from scripts/
__pycache__/
*.pyc

# Scratch sheet with real universe ids and personal notes. Not for the repo.
TRY-IT.md

# Local live-test material: real universe and place ids, and the scripts that
# run against them. Personal and operational data. Never tracked.
.local/

# Local copies written before an overwrite. They do not belong to the
# repository.
*.backup.json

# Place files used to exercise `rbx place` against the throwaway universe. A
# .rbxl is an opaque binary that can carry anything that was in the place when
# it was saved, so it is ignored by extension rather than by name: the point is
# that no future one gets committed either.
*.rbxl
*.rbxlx

# staging area for the extracted crate, never committed here
extracted/
