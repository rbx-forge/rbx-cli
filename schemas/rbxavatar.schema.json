    "AvatarCollisionRules": {
      "description": "How avatars collide with the world and with each other.",
      "type": "object",
      "properties": {
        "CollisionMode": {
          "description": "`0` = default (outer box), `1` = single collider, `2` = legacy (inner box).\n\nA third numbering for collisions, and again not the one `[game.avatar] collision` uses: that field is the older `universeCollisionType`, where `1` = inner box and `2` = outer box.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "HitAndTouchDetectionMode": {
          "description": "What touch events fire against: `0` = avatar geometry, `1` = colliders.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "LegacyCollisionMode": {
          "description": "Purpose undocumented; observed as `1` in every example seen. Left in the schema because omitting a key people will find in their own file is how a schema teaches them to ignore it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "SingleColliderSize": {
          "description": "Size of the collider used when `CollisionMode` is single collider. Three numbers.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      }
    },
    "AvatarRules": {
      "description": "Which rig players get.",
      "type": "object",
      "properties": {
        "AvatarType": {
          "description": "`0` = R6, `1` = R15, `2` = both.\n\n**Not the same numbering as `[game.avatar] type`**, which is Roblox's older `universeAvatarType` and runs `1` = R6, `2` = player choice, `3` = R15. The two fields describe the same idea through different endpoints and disagree on the integers; setting one from the other's value silently picks the wrong rig.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      }
    }
